(Text content="<section>\n    ")
(Include raw="{% include 'partial/plain.html' %}" path="partial/plain.html" with_variables="" only=false is_literal=true)
(Text content="\n    ")
(Include raw="{% include 'partial/greeting.html' with name=customer.name %}" path="partial/greeting.html" with_variables="name=customer.name" only=false is_literal=true)
(Text content="\n    ")
(Include raw="{% include 'partial/greeting.html' with name='Anonymous' only %}" path="partial/greeting.html" with_variables="name='Anonymous'" only=true is_literal=true)
(Text content="\n\n    <table>\n        ")
(For raw="{% for item in items %}" variable="item" iterable="items")
  :body
    (Text content="\n            ")
    (Include raw="{% include 'partial/row.html' with item=item %}" path="partial/row.html" with_variables="item=item" only=false is_literal=true)
    (Text content="\n        ")
(Text content="\n    </table>\n\n    ")
(Include raw="{% include 'partial/outer.html' %}" path="partial/outer.html" with_variables="" only=false is_literal=true)
(Text content="\n</section>\n")
