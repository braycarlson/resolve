(Extends raw="{% extends 'section.html' %}" parent_path="section.html" is_literal=true)
(Text content="\n\n")
(Block raw="{% block title %}" name="title" has_super_reference=false)
  :content
    (Text content="Page title")
(Text content="\n\n")
(Block raw="{% block content %}" name="content" has_super_reference=true)
  :content
    (Text content="\n    ")
    (Variable raw="{{ block.super }}" expression="block.super" filters="")
    (Text content="\n    <p>Page content</p>\n")
(Text content="\n")
