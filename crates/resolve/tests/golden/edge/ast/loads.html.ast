(Load raw="{% load static %}" libraries="static")
(Text content="\n")
(Load raw="{% load i18n l10n %}" libraries="i18n,l10n")
(Text content="\n")
(Load raw="{% load humanize %}" libraries="humanize")
(Text content="\n<img src=\"")
(Static raw="{% static 'logo.png' %}" path="logo.png")
(Text content="\" alt=\"")
(Trans raw="{% trans 'Logo' %}" message="Logo")
(Text content="\">\n")
